{
  // 门户网站 quotlet.com：静态文件 + 一个很小的 Worker（只负责 www 跳转）。内容由 scripts/deploy-site.sh 打包到 build/site
  "name": "quotlet",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "../build/site", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "routes": [
    { "pattern": "quotlet.com", "custom_domain": true },
    { "pattern": "www.quotlet.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
